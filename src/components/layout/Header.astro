---
// Header.astro — navegación principal con menú hamburguesa (móvil)
import { SITE, waLink } from '../../data/site.ts';

const navLinks = [
  { label: 'Servicios', href: '#servicios' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'Sectores', href: '#sectores' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="header">
  <div class="container nav">
   <a href="#inicio" class="brand">
      <img src="/logo-mark.svg" alt={SITE.name} class="mark" width="38" height="38" />
      <span>{SITE.name}</span>
    </a>

    <!-- checkbox que controla el menú (funciona sin JS) -->
    <input type="checkbox" id="navToggle" class="nav-toggle" aria-hidden="true" tabindex="-1" />

    <nav class="nav-links" id="navlinks">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={waLink('Hola J&M, quiero información.')} class="btn btn-primary menu-cta">Escríbenos</a>
    </nav>

    <div class="nav-cta">
      <a href={waLink('Hola J&M, quiero información.')} class="btn btn-primary desktop-cta">Escríbenos</a>
      <label for="navToggle" class="menu-btn" aria-label="Abrir menú" role="button" tabindex="0">
        <span></span><span></span><span></span>
      </label>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-lg);
    color: var(--color-primary-deep);
  }
  .mark {
    width: 38px;
    height: 38px;
    flex: none;
  }
  .nav-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .nav-links a {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-muted);
    transition: color var(--transition);
  }
  .nav-links a:hover { color: var(--color-primary); }
  .nav-cta { display: flex; align-items: center; gap: var(--space-2); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-full);
    transition: transform var(--transition), background var(--transition);
  }
  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    box-shadow: var(--shadow-sm);
  }
  .btn-primary:hover {
    background: var(--color-accent-deep);
    color: #fff;
    transform: translateY(-2px);
  }

  /* hamburguesa: oculto en desktop */
  .nav-toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .menu-btn { display: none; width: 44px; height: 44px; position: relative; -webkit-tap-highlight-color: transparent; }
  .menu-btn span {
    position: absolute; left: 11px; right: 11px; height: 2.5px;
    background: var(--color-primary-deep); border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .menu-btn span:nth-child(1) { top: 15px; }
  .menu-btn span:nth-child(2) { top: 21px; }
  .menu-btn span:nth-child(3) { top: 27px; }
  .nav-toggle:checked ~ .nav-cta .menu-btn span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle:checked ~ .nav-cta .menu-btn span:nth-child(2) { opacity: 0; }
  .nav-toggle:checked ~ .nav-cta .menu-btn span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .menu-cta { display: none; }

  /* ---------- MÓVIL ---------- */
  @media (max-width: 920px) {
    .nav-links { display: none; }
    .menu-btn { display: block; }
    .desktop-cta { display: none; }

    .nav-toggle:checked ~ .nav-links {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 74px; left: 0; right: 0;
      background: var(--color-bg);
      padding: 14px 24px 24px;
      border-bottom: 1px solid var(--color-line);
      box-shadow: var(--shadow);
      max-height: calc(100vh - 74px);
      overflow-y: auto;
    }
    .nav-links a:not(.menu-cta) {
      padding: 0.95rem 0.25rem;
      font-size: var(--fs-lg);
      color: var(--color-primary-deep);
      border-bottom: 1px solid var(--color-line);
    }
    .menu-cta {
      display: inline-flex;
      justify-content: center;
      margin-top: 1rem;
      color: var(--color-accent-ink);
    }
  }
</style>

<script>
  // Mejora progresiva: cerrar el menú al elegir opción, al tocar fuera o con Escape.
  // (El menú ya abre/cierra solo con CSS aunque este script no corra.)
  const toggle = document.getElementById('navToggle') as HTMLInputElement | null;
  const nav = document.getElementById('navlinks');
  if (toggle && nav) {
    const close = () => (toggle.checked = false);
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (toggle.checked && !nav.contains(t) && !(t as HTMLElement).closest('.menu-btn')) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    window.addEventListener('resize', () => { if (window.innerWidth > 920) close(); });
  }
</script>
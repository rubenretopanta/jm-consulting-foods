---
// Header.astro — navegación principal con menú hamburguesa (móvil)
import { SITE, waLink } from '../../data/site.ts';
import { getCollection } from 'astro:content';

// El enlace "Clientes" solo se muestra si hay clientes publicados (no borrador),
// igual que la sección: así nunca queda un enlace que no lleve a nada.
const hayClientes = (await getCollection('clientes', ({ data }) => !data.draft)).length > 0;

const navLinks = [
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Nosotros', href: '/#nosotros' },
  { label: 'Proceso', href: '/#proceso' },
  { label: 'Sectores', href: '/#sectores' },
  ...(hayClientes ? [{ label: 'Clientes', href: '/#clientes' }] : []),
  { label: 'Blog', href: '/blog/' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="header">
  <div class="container nav">
   <a href="/#inicio" class="brand" aria-label={SITE.name}>
      <img src="/logo-jm.png" alt="" class="brand-mark" width="333" height="138" />
      <span class="brand-word">Consulting Foods</span>
    </a>

    <!-- checkbox que controla el menú (funciona sin JS) -->

    <nav class="nav-links" id="navlinks">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={waLink('Hola J&M, quiero información.')} class="btn btn-primary menu-cta">Escríbenos</a>
    </nav>

    <div class="nav-cta">
      <a href={waLink('Hola J&M, quiero información.')} class="btn btn-primary desktop-cta">Escríbenos</a>
     <button type="button" id="menuBtn" class="menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="navlinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    gap: 3px;
  }
  /* La marca (J&M + emblema) va como imagen; "Consulting Foods" va como texto
     real, porque a este tamano un mapa de bits se ve borroso. */
  .brand-mark {
    display: block;
    height: 46px;
    width: auto;
  }
  .brand-word {
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #0F0F0F;
  }
  .nav-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    /* El menu arranca junto al logo; el boton de WhatsApp se queda a la derecha. */
    margin-inline: var(--space-4) auto;
  }
  .nav-links a {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-muted);
    transition: color var(--transition);
  }
  .nav-links a:hover { color: var(--color-primary); }
  .nav-cta { display: flex; align-items: center; gap: var(--space-2); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-full);
    transition: transform var(--transition), background var(--transition);
  }
  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    box-shadow: var(--shadow-sm);
  }
  .btn-primary:hover {
    background: var(--color-accent-deep);
    color: #fff;
    transform: translateY(-2px);
  }

  /* hamburguesa: oculto en desktop */
  .nav-toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .menu-btn { display: none; width: 44px; height: 44px; position: relative; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .menu-btn span {
    position: absolute; left: 11px; right: 11px; height: 2.5px;
    background: var(--color-primary-deep); border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .menu-btn span:nth-child(1) { top: 15px; }
  .menu-btn span:nth-child(2) { top: 21px; }
  .menu-btn span:nth-child(3) { top: 27px; }
  .menu-btn.is-open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-btn.is-open span:nth-child(2) { opacity: 0; }
  .menu-btn.is-open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .menu-cta { display: none; }

  /* ---------- MÓVIL ---------- */
  @media (max-width: 920px) {
    .brand-mark { height: 38px; }
    .brand-word { font-size: 9.5px; }
    .nav-links { display: none; margin-inline: 0; }
    .menu-btn { display: block; }
    .desktop-cta { display: none; }

    .nav-links.is-open {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--header-h); left: 0; right: 0;
      background: var(--color-bg);
      padding: 14px 24px 24px;
      border-bottom: 1px solid var(--color-line);
      box-shadow: var(--shadow);
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
    }
    .nav-links a:not(.menu-cta) {
      padding: 0.95rem 0.25rem;
      font-size: var(--fs-lg);
      color: var(--color-primary-deep);
      border-bottom: 1px solid var(--color-line);
    }
    .menu-cta {
      display: inline-flex;
      justify-content: center;
      margin-top: 1rem;
      color: var(--color-accent-ink);
    }
  }
</style>

<script>
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('navlinks');

  function toggleMenu() {
    const open = nav.classList.toggle('is-open');
    btn.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  function closeMenu() {
    nav.classList.remove('is-open');
    btn.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
  }

  if (btn && nav) {
    btn.addEventListener('click', toggleMenu);
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target) && !btn.contains(e.target)) closeMenu();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
    window.addEventListener('resize', () => { if (window.innerWidth > 920) closeMenu(); });
  }
</script>
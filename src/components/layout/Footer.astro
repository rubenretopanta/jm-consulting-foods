---
import { SITE, waLink } from '../../data/site.ts';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container foot-top">
   <div class="foot-brand">
      <div class="brand-row" aria-label={SITE.name} role="img">
        <img src="/logo-jm-claro.png" alt="" class="brand-mark" width="333" height="138" />
        <span class="brand-word">Consulting Foods</span>
      </div>
      <p>Consultoría en calidad e inocuidad alimentaria. Te ayudamos a cumplir la norma y crecer con confianza.</p>
      <a class="wa" href={waLink('Hola J&M, quiero información.')}>Escríbenos por WhatsApp →</a>

      <div class="socials">
        {SITE.social.facebook && (
          <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
        )}
        {SITE.social.linkedin && (
          <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0Z"/></svg>
          </a>
        )}
        {SITE.social.instagram && (
          <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.62c-3.15 0-3.52.01-4.76.07-1.15.05-1.77.24-2.19.41-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.17.42-.36 1.04-.41 2.19-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.05 1.15.24 1.77.41 2.19.21.55.47.94.88 1.35.41.41.8.67 1.35.88.42.17 1.04.36 2.19.41 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c1.15-.05 1.77-.24 2.19-.41.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.17-.42.36-1.04.41-2.19.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.05-1.15-.24-1.77-.41-2.19a3.63 3.63 0 0 0-.88-1.35 3.63 3.63 0 0 0-1.35-.88c-.42-.17-1.04-.36-2.19-.41-1.24-.06-1.61-.07-4.76-.07Zm0 2.76a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6Zm0 1.62a3.68 3.68 0 1 0 0 7.36 3.68 3.68 0 0 0 0-7.36Zm5.48-.66a1.24 1.24 0 1 1-2.48 0 1.24 1.24 0 0 1 2.48 0Z"/></svg>
          </a>
        )}
      </div>
    </div>

    <div class="foot-data">
      <div><small>Razón social</small><strong>{SITE.legalName}</strong></div>
      <div><small>RUC</small><strong>{SITE.ruc}</strong></div>
      <div><small>Correo</small><strong>{SITE.email}</strong></div>
      <div><small>WhatsApp</small><strong>{SITE.whatsappDisplay}</strong></div>
      {SITE.phoneAlt && <div><small>Teléfono</small><strong>{SITE.phoneAltDisplay}</strong></div>}
      <div><small>Ubicación</small><strong>{SITE.city}</strong></div>
    </div>
  </div>

  <div class="container foot-bottom">
    <span>© {year} {SITE.legalName}. Todos los derechos reservados.</span>
    <span class="foot-bottom-right">
      Hecho con cuidado para negocios de alimentos.
      <a class="admin-link" href="/admin/">Acceder</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-surface);
    color: #fff;
    padding-block: var(--space-5) var(--space-3);
    /* Filo superior con el verde exacto del emblema: firma de marca en dosis minima. */
    border-top: 3px solid var(--color-brand-green);
  }
  .foot-top { display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; padding-bottom: var(--space-3); border-bottom: 1px solid rgba(255,255,255,0.12); }

  /* Version clara del logo, para que las letras se lean sobre el fondo verde.
     "Consulting Foods" va como texto real para que se vea nitido. */
  .brand-row { display: inline-flex; flex-direction: column; align-items: center; gap: 3px; }
  .brand-mark { display: block; height: 48px; width: auto; }
  .brand-word {
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: 11.5px;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
  }
  .foot-brand p { color: #fff; font-size: var(--fs-sm); max-width: 36ch; margin-block: var(--space-2); }
  .wa { color: var(--color-accent); font-weight: var(--fw-semibold); font-size: var(--fs-sm); }
  .wa:hover { text-decoration: underline; }
  .socials { display: flex; gap: 0.6rem; margin-top: var(--space-3); }
  .socials a {
    width: 38px; height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.14);
    color: #fff;
    display: grid; place-items: center;
    transition: background var(--transition), transform var(--transition);
  }
  .socials a:hover { background: var(--color-accent); color: var(--color-accent-ink); transform: translateY(-2px); }

  .foot-data { display: grid; grid-template-columns: repeat(2, auto); gap: var(--space-2) var(--space-5); }
  .foot-data small { display: block; color: #fff; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em; }
  .foot-data strong { color: #fff; font-weight: var(--fw-semibold); font-size: var(--fs-sm); }

  .foot-bottom { padding-top: var(--space-3); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-1); font-size: var(--fs-xs); }
  .foot-bottom-right { display: inline-flex; align-items: center; gap: var(--space-2); }
  .admin-link { color: #fff; transition: color var(--transition); }
  .admin-link:hover { color: var(--color-accent); }

  @media (max-width: 700px) { .foot-data { grid-template-columns: 1fr; } }
</style>
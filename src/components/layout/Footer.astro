---
// Footer.astro — cierre corporativo del sitio.
//
// EL LOGO NO SE TOCA: aquí va la versión clara del mismo archivo original
// (/logo-jm-claro.png) más "Consulting Foods" en su serif, igual que en la
// cabecera. Solo cambian tamaño y posición.
import { SITE, waLink } from '../../data/site.ts';
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';

const year = new Date().getFullYear();

// Los servicios del pie salen de la misma colección que la sección de
// servicios: si el cliente añade uno desde el panel, aparece también aquí.
const servicios = (await getCollection('services')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const hayClientes = (await getCollection('clientes', ({ data }) => !data.draft)).length > 0;
const hayBlog = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;

const enlaces = [
  { label: 'Inicio', href: '/#inicio' },
  { label: 'Proceso', href: '/#proceso' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Sectores', href: '/#sectores' },
  { label: 'Nosotros', href: '/#nosotros' },
  { label: 'Capacitaciones', href: '/#capacitaciones' },
  ...(hayClientes ? [{ label: 'Clientes', href: '/#clientes' }] : []),
  ...(hayBlog ? [{ label: 'Blog', href: '/blog/' }] : []),
  { label: 'Contacto', href: '/#contacto' },
];

const redes = [
  { key: 'facebook', label: 'Facebook', href: SITE.social?.facebook },
  { key: 'instagram', label: 'Instagram', href: SITE.social?.instagram },
  { key: 'linkedin', label: 'LinkedIn', href: SITE.social?.linkedin },
].filter((r) => r.href);
---

<footer class="footer">
  <div class="container foot-top">
    <!-- Columna 1: marca -->
    <div class="col col-brand">
      <div class="brand-row" role="img" aria-label={SITE.name}>
        <img src="/logo-jm-claro.png" alt="" class="brand-mark" width="333" height="138" />
        <span class="brand-word">Consulting Foods</span>
      </div>

      <p class="brand-desc">{SITE.description}</p>

      {redes.length > 0 && (
        <ul class="socials">
          {redes.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label}>
                <Icon name={r.key} size={18} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Columna 2: navegación -->
    <nav class="col" aria-labelledby="foot-nav">
      <h2 class="col-title" id="foot-nav">Enlaces rápidos</h2>
      <ul class="col-list">
        {enlaces.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <!-- Columna 3: servicios -->
    <nav class="col" aria-labelledby="foot-serv">
      <h2 class="col-title" id="foot-serv">Servicios</h2>
      <ul class="col-list">
        {servicios.map((s) => <li><a href="/#servicios">{s.data.title}</a></li>)}
      </ul>
    </nav>

    <!-- Columna 4: contacto -->
    <div class="col">
      <h2 class="col-title">Contacto</h2>
      <ul class="col-list contact-list">
        <li>
          <a href={waLink('Hola J&M, quiero información.')} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={16} /><span>{SITE.whatsappDisplay}</span>
          </a>
        </li>
        {SITE.phoneAlt && (
          <li>
            <a href={`tel:+51${SITE.phoneAlt}`}>
              <Icon name="phone" size={16} /><span>{SITE.phoneAltDisplay}</span>
            </a>
          </li>
        )}
        <li>
          <a href={`mailto:${SITE.email}`}>
            <Icon name="mail" size={16} /><span>{SITE.email}</span>
          </a>
        </li>
        <li>
          <span class="plain"><Icon name="map-pin" size={16} /><span>{SITE.address}</span></span>
        </li>
      </ul>

      <dl class="legal">
        <div><dt>Razón social</dt><dd>{SITE.legalName}</dd></div>
        <div><dt>RUC</dt><dd>{SITE.ruc}</dd></div>
      </dl>
    </div>
  </div>

  <div class="container foot-bottom">
    <span>© {year} {SITE.legalName}. Todos los derechos reservados.</span>
    <span class="foot-bottom-right">
      Hecho con cuidado para negocios de alimentos.
      <a class="admin-link" href="/admin/">Acceder</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: #fff;
    padding-block: clamp(2.75rem, 5vw, 4.25rem) var(--space-3);
    /* Filo superior con el verde exacto del emblema: firma de marca en la
       dosis mínima, donde no compite con ningún texto. */
    border-top: 3px solid var(--color-brand-green);
  }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 3rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--color-dark-line);
  }

  /* ---------- LOGO ----------
     Versión clara del mismo archivo original. "Consulting Foods" va como
     texto real para que se vea nítido: no fusionar las dos piezas. */
  .brand-row { display: inline-flex; flex-direction: column; align-items: center; gap: 3px; }
  .brand-mark { display: block; height: 46px; width: auto; }
  .brand-word {
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: 11.5px;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
  }

  .brand-desc {
    margin-top: var(--space-3);
    max-width: 34ch;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--color-on-dark-muted);
  }

  .socials { display: flex; gap: 0.5rem; margin-top: var(--space-3); }
  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: background var(--t), color var(--t), transform var(--t);
  }
  .socials a:hover {
    background: var(--color-brand-green);
    color: #fff;
    transform: translateY(-2px);
  }

  /* ---------- COLUMNAS ---------- */
  .col-title {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #fff;
    margin-bottom: var(--space-2);
  }
  .col-list { display: grid; gap: 0.15rem; }
  .col-list a,
  .col-list .plain {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* 36px de alto: se puede tocar cómodamente en celular sin separar tanto
       los enlaces que la columna se estire de más. */
    min-height: 36px;
    font-size: var(--fs-sm);
    color: var(--color-on-dark-muted);
    overflow-wrap: anywhere;
    transition: color var(--t), transform var(--t);
  }
  .col-list a :global(svg),
  .col-list .plain :global(svg) { flex: none; color: var(--color-brand-green); }
  .col-list a:hover { color: #fff; }
  .contact-list a:hover { transform: translateX(2px); }

  .legal {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-dark-line);
  }
  .legal dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .legal dd { font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: #fff; }

  /* ---------- LÍNEA FINAL ---------- */
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding-top: var(--space-3);
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.6);
  }
  .foot-bottom-right { display: inline-flex; align-items: center; gap: var(--space-2); }
  .admin-link { color: rgba(255, 255, 255, 0.8); transition: color var(--t); }
  .admin-link:hover { color: var(--color-brand-green); }

  /* ---------- TABLET ---------- */
  @media (max-width: 960px) {
    .foot-top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .col-brand { grid-column: 1 / -1; }
    .brand-desc { max-width: 48ch; }
  }

  /* ---------- CELULAR ---------- */
  @media (max-width: 560px) {
    .foot-top { grid-template-columns: 1fr; gap: var(--space-4); }
    .brand-mark { height: 40px; }
    .foot-bottom { justify-content: flex-start; }
  }
</style>

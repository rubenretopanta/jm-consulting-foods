---
/**
 * ServiceCard.astro — tarjeta de servicio: foto, icono, título, descripción
 * y el detalle completo plegado.
 *
 * El detalle (los "bullets" que ya existían) no se pierde: vive dentro de un
 * <details> nativo, así la primera vista queda limpia y la información sigue
 * a un clic, sin JavaScript y navegable con el teclado.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  icon?: string;
  bullets?: string[];
  delay?: number;
}

const { title, description, image, icon = 'file-check', bullets = [], delay = 0 } = Astro.props;
---

<article class="card reveal" data-delay={String(Math.min(delay, 5))}>
  {image && (
    <div class="card-media">
      <img src={image} alt="" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="card-body">
    <span class:list={['card-ic', !image && 'is-flat']}>
      <Icon name={icon} size={22} />
    </span>

    <h3>{title}</h3>
    <p class="card-desc">{description}</p>

    {bullets.length > 0 && (
      <details class="card-more">
        <summary>
          <span class="more-label">Conocer servicio</span>
          <Icon name="chevron-down" size={16} class="more-chevron" />
        </summary>
        <ul class="bullets">
          {bullets.map((b) => (
            <li><Icon name="check" size={14} /><span>{b}</span></li>
          ))}
        </ul>
      </details>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--t), box-shadow var(--t), border-color var(--t);
  }
  /* Elevación contenida: 5 px y una sombra algo mayor. Nada de saltos. */
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: var(--color-line-2);
  }

  .card-media {
    position: relative;
    overflow: hidden;
    background: var(--color-band-2);
  }
  .card-media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--t-slow);
  }
  /* Acercamiento muy leve de la foto: se nota, pero no marea. */
  .card:hover .card-media img { transform: scale(1.045); }

  .card-body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3);
    padding-top: calc(var(--space-3) + 14px);
  }

  /* El icono monta sobre la foto y ancla visualmente la tarjeta. */
  .card-ic {
    position: absolute;
    top: -22px;
    left: var(--space-3);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-primary-deep);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-line);
  }
  /* Si el servicio no tiene foto, el icono no monta sobre nada: va en flujo. */
  .card-ic.is-flat { position: static; margin-bottom: var(--space-2); }

  .card h3 { margin-bottom: 0.5rem; font-size: var(--fs-lg); }
  .card-desc { font-size: var(--fs-sm); line-height: 1.6; }

  /* ---------- Detalle plegado ---------- */
  .card-more { margin-top: auto; padding-top: var(--space-3); }
  .card-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
    transition: color var(--t), gap var(--t);
  }
  .card-more summary::-webkit-details-marker { display: none; }
  .card-more summary:hover { color: var(--color-primary-deep); gap: 0.6rem; }
  .card-more summary:focus-visible { outline: 3px solid var(--color-brand-green); outline-offset: 3px; }
  /* El <svg> lo dibuja <Icon />, que no hereda el ambito de este
     componente: hace falta :global() colgando de .card-more, que si lo tiene. */
  .card-more :global(.more-chevron) { transition: transform var(--t); }
  .card-more[open] :global(.more-chevron) { transform: rotate(180deg); }

  .bullets {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }
  .bullets li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--color-muted);
  }
  .bullets :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
    .card:hover .card-media img { transform: none; }
  }
</style>

---
/**
 * WhatsAppDock.astro — botón flotante de WhatsApp, solo el símbolo.
 *
 * Un único círculo verde en la esquina inferior derecha, igual en celular y en
 * escritorio (así se ve en la mayoría de sitios: solo el icono, sin texto).
 * Se aparta al llegar a la sección de contacto, donde el formulario ya ofrece
 * la misma acción, y respeta la franja del gesto de inicio en iPhone.
 */
import { waLink } from '../../data/site.ts';
import Icon from './Icon.astro';

const href = waLink('Hola J&M, quiero solicitar una asesoría.');
---

<a
  class="wa-fab"
  id="waDock"
  data-wa-dock
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp para solicitar una asesoría"
  title="Solicitar asesoría por WhatsApp"
>
  <Icon name="whatsapp" size={30} />
</a>

<style>
  .wa-fab {
    position: fixed;
    /* Se alinea con el borde derecho del contenido (el mismo del .container),
       no con el borde de la ventana: en pantallas anchas el círculo queda
       dentro de la página y no flotando en el margen vacío. */
    right: max(
      calc(var(--gutter) + env(safe-area-inset-right, 0px)),
      calc((100vw - var(--container)) / 2 + var(--gutter))
    );
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: grid;
    place-items: center;
    /* 56px: el mínimo cómodo para el pulgar sin robarle sitio al contenido. */
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-lg), 0 0 0 6px rgba(33, 118, 25, 0.12);
    transition: transform var(--t), background var(--t), opacity var(--t-slow);
  }
  .wa-fab:hover { background: var(--color-primary-deep); transform: translateY(-2px) scale(1.04); }
  .wa-fab:active { transform: scale(0.96); }

  /* Se aparta cuando el visitante ya está en la sección de contacto. */
  .wa-fab.is-hidden {
    transform: translateY(140%);
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .wa-fab { width: 54px; height: 54px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab { transition: opacity var(--t); }
    .wa-fab:hover, .wa-fab:active { transform: none; }
  }
</style>

<script>
  // Esconde el botón mientras la sección de contacto está a la vista: allí el
  // formulario ya ofrece la misma acción y el círculo solo taparía campos.
  const dock = document.querySelector('[data-wa-dock]');
  const contacto = document.getElementById('contacto');

  if (dock && contacto && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => dock.classList.toggle('is-hidden', entry.isIntersecting),
      { threshold: 0.12 }
    ).observe(contacto);
  }
</script>

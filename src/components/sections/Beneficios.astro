---
// Beneficios.astro — beneficios de implementar el sistema HACCP (brochure, pág. 2).
// Mismo contenido de siempre; cambia la composición: la foto ancla la columna
// izquierda y la lista se lee en dos columnas para no formar un muro de texto.
import home from '../../data/home.json';
import Icon from '../ui/Icon.astro';

const { beneficios } = home;

// El subtítulo que trae el brochure es, palabra por palabra, el primer punto
// de la lista. Se muestra arriba como entradilla y se quita de la lista para
// no leerlo dos veces seguidas. Ambos campos siguen siendo editables desde el
// panel: si el cliente cambia uno, dejan de coincidir y se ven los dos.
const norm = (s: string) => s.trim().toLowerCase().replace(/\s+/g, ' ');
const lista = beneficios.lista.filter(
  (item) => !beneficios.subtitulo || norm(item) !== norm(beneficios.subtitulo)
);
---

<section class="benefits section band" id="beneficios">
  <div class="container benefits-grid">
    {beneficios.imagen && (
      <figure class="benefits-media reveal">
        <img
          src={beneficios.imagen}
          alt="Consumidores eligiendo alimentos en el punto de venta"
          width="1192"
          height="796"
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    <div class="benefits-text">
      <p class="eyebrow reveal">{beneficios.eyebrow}</p>
      <h2 class="reveal" data-delay="1">{beneficios.titulo}</h2>
      {beneficios.subtitulo && <p class="benefits-lead reveal" data-delay="1">{beneficios.subtitulo}</p>}

      <ul class="list reveal" data-delay="2">
        {lista.map((item) => (
          <li>
            <span class="tick"><Icon name="check" size={13} stroke={2.4} /></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .benefits-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .benefits-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .benefits-media img {
    display: block;
    width: 100%;
    /* 5/4: la foto original es horizontal (1192×796). En 4/5 se perdía
       casi la mitad del encuadre. */
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  .benefits-text h2 { margin-block: 0.6rem 0; }

  .benefits-lead {
    margin-top: var(--space-2);
    font-size: var(--fs-lg);
    line-height: 1.6;
    max-width: 40rem;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }
  .list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--radius-full);
    background: var(--color-primary-soft);
    color: var(--color-primary-deep);
  }

  @media (max-width: 960px) {
    .benefits-grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .benefits-media { order: -1; }
    .benefits-media img { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 600px) {
    .list { grid-template-columns: 1fr; }
  }
</style>

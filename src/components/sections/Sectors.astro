---
// Sectors.astro — los sectores que atiende J&M. La lista es exactamente la
// que ya estaba en home.json: no se añade ni se quita ninguno.
import home from '../../data/home.json';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

const { sectores: sectoresData } = home;
const sectores = sectoresData.lista;

// El icono se elige por lo que dice el propio texto del sector, no por su
// posición: así el cliente puede reordenar o renombrar desde el panel y cada
// uno sigue llevando el icono que le toca. Si no reconoce ninguno, hoja.
const REGLAS: Array<[RegExp, string]> = [
  [/restaurant|servicio|comedor|cocina/i, 'utensils'],
  [/panific|paster|panad/i, 'bread'],
  [/agroindustr|agrícola|agricola|granos|andin/i, 'wheat'],
  [/pesquer|pescad|marino|acuícola|acuicola/i, 'fish'],
  [/bebida|agua|jugo|lácte|lacte/i, 'bottle'],
  [/programa|social|qali|escolar|institucion/i, 'users'],
];

const iconoDe = (texto: string) => REGLAS.find(([re]) => re.test(texto))?.[1] ?? 'leaf';
---

<section class="sectors section" id="sectores">
  <div class="container">
    <SectionHeader
      eyebrow={sectoresData.eyebrow}
      title={sectoresData.titulo}
      subtitle={sectoresData.subtitulo}
      align="center"
      class="reveal"
    />

    <ul class="grid">
      {sectores.map((sector, i) => (
        <li class="sector reveal" data-delay={String(i % 3)}>
          <span class="sector-ic"><Icon name={iconoDe(sector)} size={24} /></span>
          <span class="sector-name">{sector}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.8vw, 1.25rem);
  }

  .sector {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 88px;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    transition: transform var(--t), box-shadow var(--t), border-color var(--t);
  }
  .sector:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
    border-color: var(--color-line-2);
  }

  .sector-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
    color: var(--color-primary-deep);
    transition: background var(--t), color var(--t);
  }
  .sector:hover .sector-ic { background: var(--color-primary); color: #fff; }

  .sector-name {
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    line-height: 1.35;
  }

  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .sector { min-height: 74px; padding: var(--space-2) var(--space-3); }
    .sector-ic { width: 42px; height: 42px; }
    .sector-name { font-size: var(--fs-base); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sector:hover { transform: none; }
  }
</style>

---
// Clientes.astro — muro de logos, desde la colección de contenido.
// Los clientes son exactamente los que hay publicados: ni uno más, ni uno
// menos. La sección solo se renderiza si hay al menos uno.
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

const { clientes: textos } = home;

const clientes = (await getCollection('clientes', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

{clientes.length > 0 && (
  <section class="clients section" id="clientes">
    <div class="container">
      <SectionHeader
        eyebrow={textos.eyebrow}
        title={textos.titulo}
        subtitle={textos.subtitulo}
        align="center"
        class="reveal"
      />

      {textos.conteoLabel && (
        <p class="count reveal">
          <strong>{clientes.length}</strong>
          <span>{textos.conteoLabel}</span>
        </p>
      )}

      <div class="carousel reveal" data-clientes-carousel>
        <div
          class="track"
          data-track
          tabindex="0"
          role="region"
          aria-roledescription="carrusel"
          aria-label="Logos de clientes"
        >
          {clientes.map((cliente) => (
            <article class="client-card">
              <div class="logo-box">
                {cliente.data.image ? (
                  <img
                    class="logo"
                    src={cliente.data.image}
                    alt={cliente.data.name}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="logo-ph">{cliente.data.name.trim().charAt(0).toUpperCase()}</span>
                )}
              </div>
              <h3>{cliente.data.name}</h3>
              {cliente.data.description && <p class="client-desc">{cliente.data.description}</p>}
            </article>
          ))}
        </div>

        <div class="controls" data-controls hidden>
          <button type="button" class="nav" data-prev aria-label="Ver clientes anteriores">
            <Icon name="chevron-left" size={20} />
          </button>
          <button type="button" class="nav" data-next aria-label="Ver más clientes">
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* Prueba social: el número sale del total de clientes publicados. */
  .count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: calc(var(--space-3) * -1) auto var(--space-4);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-soft);
    color: var(--color-primary-deep);
    font-size: var(--fs-sm);
  }
  .count strong { font-size: var(--fs-lg); font-weight: var(--fw-bold); color: inherit; }

  /* Una sola fila, siempre. Avanza sola y también con las flechas.
     --per-view manda el ancho de cada tarjeta y --logo-h el tamaño del logo:
     los dos van juntos, porque lo que se ve como "distancia entre clientes"
     es el aire que sobra en la tarjeta alrededor del logo. Tarjeta angosta +
     logo grande = logos que se leen como una fila, no como puntos sueltos. */
  .carousel {
    --gap: clamp(0.4rem, 0.9vw, 0.7rem);
    --per-view: 7;
    --logo-h: 114px;
    position: relative;
  }

  .track {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    /* Aire para que la elevación del hover y la sombra no se recorten. */
    padding: 8px 2px 16px;
    margin-inline: -2px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }
  /* El desplazamiento lo controla el script; el anclaje solo se usa cuando el
     visitante pidió menos movimiento y el carrusel avanza por pasos. */
  .track.is-snapping { scroll-snap-type: x mandatory; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 3px solid var(--color-brand-green); outline-offset: 4px; border-radius: var(--radius); }

  /* Sin marco ni borde: los logos ya son formas muy dispares, y encerrarlos
     en cajas duplicaba el ruido visual. Los separa el espacio. */
  .client-card {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: var(--space-2) 0.35rem;
    border-radius: var(--radius);
    background: transparent;
    transition: transform var(--t), background var(--t);
  }
  .client-card:hover { transform: translateY(-4px); background: var(--color-band); }

  /* Caja de alto fijo: los logos tienen proporciones muy distintas y así
     quedan todos alineados sobre la misma línea óptica. */
  /* El alto lo manda --logo-h: la mayoría de estos archivos son cuadrados, así
     que el alto es también su ancho en pantalla y por tanto lo que decide si
     los logos quedan pegados o separados. */
  .logo-box {
    height: var(--logo-h);
    width: 100%;
    display: grid;
    place-items: center;
  }
  .logo {
    max-width: 100%;
    max-height: var(--logo-h);
    width: auto;
    height: auto;
    object-fit: contain;
    transition: filter var(--t), opacity var(--t);
  }
  /* Los logos van A COLOR, como en la referencia del cliente.
     Antes iban en escala de grises para que el muro se leyera como un
     conjunto, pero buena parte de estos archivos son JPEG con fondo gris
     (Gustozzi, Zedina, Selva Plant, Bon Beef): en gris dejaban de parecer
     logos y quedaban como bloques opacos. Lo que unifica el muro ahora es la
     caja de alto fijo y el espacio, no el color.
     El reposo va un punto por debajo del negro pleno y el hover lo sube a
     tope: es el "aumentar ligeramente el contraste" del encargo, sin tocar
     ningún archivo original. */
  .logo { opacity: 0.88; }
  @media (hover: hover) and (pointer: fine) {
    .client-card:hover .logo,
    .track:focus-visible .logo { opacity: 1; }
  }
  /* En celular, siempre a tope: allí no hay hover que lo recupere. */
  @media (max-width: 920px) {
    .logo { opacity: 1; }
  }

  .logo-ph {
    display: grid;
    place-items: center;
    width: 62px; height: 62px;
    border-radius: var(--radius-full);
    background: var(--color-primary-soft);
    color: var(--color-primary-deep);
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
  }

  .client-card h3 {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--color-faint);
    text-align: center;
    line-height: 1.35;
    transition: color var(--t);
  }
  .client-card:hover h3 { color: var(--color-ink); }

  /* El rubro de cada cliente. A dos líneas como máximo: son textos de largo
     muy desigual y sin el tope la fila de logos se descuadra. */
  .client-desc {
    margin-top: -0.35rem;
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--color-faint);
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Flechas encima de las tarjetas. La capa cubre el carrusel pero deja pasar
     el dedo y la rueda: solo los botones reciben clics. */
  .controls { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .controls[hidden] { display: none; }
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, #fff 90%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-sm);
    color: var(--color-ink);
    transition: background var(--t), border-color var(--t), color var(--t), opacity var(--t);
  }
  .nav[data-prev] { left: calc(var(--space-2) * -1); }
  .nav[data-next] { right: calc(var(--space-2) * -1); }
  .nav:hover:not(:disabled) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  /* Extremos: la flecha queda a la vista pero apagada y sin responder. */
  .nav:disabled { opacity: 0.28; cursor: default; box-shadow: none; }

  @media (max-width: 1120px) { .carousel { --per-view: 6.2; --logo-h: 106px; } }
  @media (max-width: 920px)  { .carousel { --per-view: 5.2; --logo-h: 98px; }
    /* A este ancho el rubro ya no cabe legible: manda el logo. */
    .client-desc { display: none; } }
  @media (max-width: 700px)  { .carousel { --per-view: 4.4; --logo-h: 88px; } }

  @media (max-width: 520px) {
    .carousel { --per-view: 3.6; --logo-h: 76px; }
    .nav { width: 40px; height: 40px; }
    .nav[data-prev] { left: 0; }
    .nav[data-next] { right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-card:hover { transform: none; }
  }
</style>

<script>
  // Carrusel de clientes.
  // - Avanza solo, despacio y en bucle, para que se vean todos los logos sin hacer clic.
  // - Se detiene al pasar el mouse, al tocar, al enfocar con teclado o al usar las flechas.
  // - Las flechas avanzan una "página" (los logos visibles).
  // - Si todos los logos caben en pantalla no hay movimiento ni flechas.
  // - Si el visitante pidió menos movimiento, no hay avance automático: solo flechas por pasos.
  document.querySelectorAll('[data-clientes-carousel]').forEach((carousel) => {
    const track = carousel.querySelector('[data-track]');
    const controls = carousel.querySelector('[data-controls]');
    const prev = carousel.querySelector('[data-prev]');
    const next = carousel.querySelector('[data-next]');
    if (!track || !controls || !prev || !next) return;

    const SPEED = 26;        // píxeles por segundo del avance automático
    const RESUME = 2500;     // ms de pausa tras una interacción
    const originals = Array.from(track.children);
    const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    let clones = [];
    let loopWidth = 0;   // ancho de una vuelta completa (el set original)
    let pos = 0;         // posición real; la mandamos nosotros, no el navegador
    let target = null;   // destino cuando se usó una flecha
    let pausaHasta = 0;
    let encima = false;
    let conFoco = false;
    let raf = 0;
    let ultimoEscrito = -1;
    let enPantalla = true;
    let pestanaVisible = true;

    /* ---------- Modo simple: sin avance automático ---------- */
    const pasos = () => {
      track.classList.add('is-snapping');
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth;
        controls.hidden = max <= 1;
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max - 1;
      };
      const paso = (dir) => track.scrollBy({ left: dir * track.clientWidth, behavior: 'auto' });
      prev.addEventListener('click', () => paso(-1));
      next.addEventListener('click', () => paso(1));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    };

    /* ---------- Modo carrusel infinito ---------- */
    const medir = () => {
      // Una vuelta = desde el primer original hasta su copia.
      loopWidth = clones.length ? clones[0].offsetLeft - originals[0].offsetLeft : 0;
    };

    const clonar = () => {
      clones = originals.map((card) => {
        const copia = card.cloneNode(true);
        copia.setAttribute('aria-hidden', 'true');
        track.appendChild(copia);
        return copia;
      });
    };

    const frame = (t) => {
      const dt = Math.min((t - (frame.prev || t)) / 1000, 0.05);
      frame.prev = t;
      let mover = false;

      if (target !== null) {
        // Acercamiento suave al destino marcado por una flecha.
        pos += (target - pos) * Math.min(1, dt * 9);
        if (Math.abs(target - pos) < 0.5) { pos = target; target = null; }
        mover = true;
      } else if (!encima && !conFoco && t > pausaHasta) {
        pos += SPEED * dt;
        mover = true;
      } else {
        // En pausa seguimos al visitante. Escribir scrollLeft aquí cortaría
        // la inercia del deslizamiento en celular.
        pos = track.scrollLeft;
      }

      if (mover) {
        // Bucle sin costuras: al pasar una vuelta, volvemos al inicio del set original.
        if (loopWidth > 0) {
          if (pos >= loopWidth) { pos -= loopWidth; if (target !== null) target -= loopWidth; }
          else if (pos < 0)     { pos += loopWidth; if (target !== null) target += loopWidth; }
        }
        ultimoEscrito = Math.round(pos);
        track.scrollLeft = pos;
      }
      raf = requestAnimationFrame(frame);
    };

    const actualizarMotor = () => {
      if (enPantalla && pestanaVisible) {
        if (!raf) { frame.prev = 0; raf = requestAnimationFrame(frame); }
      } else if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    const pausar = (ms) => { pausaHasta = performance.now() + ms; };

    const infinito = () => {
      clonar();
      medir();
      controls.hidden = false;
      actualizarMotor();

      const page = (dir) => {
        target = (target === null ? pos : target) + dir * track.clientWidth;
        pausar(RESUME);
      };
      prev.addEventListener('click', () => page(-1));
      next.addEventListener('click', () => page(1));

      // El visitante desliza o usa la rueda: adoptamos su posición y pausamos.
      track.addEventListener('scroll', () => {
        if (Math.abs(track.scrollLeft - ultimoEscrito) > 2) {
          pos = track.scrollLeft;
          target = null;
          pausar(RESUME);
        }
      }, { passive: true });

      // Pausa al pasar el mouse: solo donde hay mouse de verdad. En pantallas
      // táctiles un toque dispara pointerenter y el "leave" podría no llegar nunca.
      if (window.matchMedia('(hover: hover)').matches) {
        carousel.addEventListener('pointerenter', () => { encima = true; });
        carousel.addEventListener('pointerleave', () => { encima = false; pausar(400); });
      }
      // Solo pausamos por foco de teclado: si contáramos también el clic, el botón
      // quedaría enfocado y el carrusel se detendría hasta hacer clic en otro lado.
      carousel.addEventListener('focusin', (e) => {
        try { conFoco = e.target.matches(':focus-visible'); } catch { conFoco = false; }
      });
      carousel.addEventListener('focusout', () => { conFoco = false; pausar(RESUME); });

      // No gastar batería si la sección no está a la vista o la pestaña está oculta.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          ([e]) => { enPantalla = e.isIntersecting; actualizarMotor(); },
          { threshold: 0 }
        ).observe(carousel);
      }
      document.addEventListener('visibilitychange', () => {
        pestanaVisible = !document.hidden;
        actualizarMotor();
      });

      window.addEventListener('resize', () => { medir(); if (loopWidth > 0) pos = Math.min(pos, loopWidth); });
    };

    // El ancho de las tarjetas es fijo (flex-basis en %) y la caja del logo tiene
    // alto fijo, así que no hace falta esperar a que carguen las imágenes para medir.
    if (menosMovimiento.matches) pasos();
    else if (track.scrollWidth - track.clientWidth > 1) infinito();
    else controls.hidden = true;
  });
</script>

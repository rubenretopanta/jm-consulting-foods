---
// Capacitaciones.astro — fotos de los talleres en planta.
//
// Se ve igual que Ferias: una fila de fotos con su pie, y flechas para seguir
// avanzando. Las dos secciones comparten el mismo componente (PhotoRail), así
// que no pueden separarse por accidente.
//
// Las fotos son 900×1200 (3:4 exacto) y el marco respeta esa proporción:
// recortarlas a horizontal les cortaría cabezas y pies.
import home from '../../data/home.json';
import SectionHeader from '../ui/SectionHeader.astro';
import PhotoRail from '../ui/PhotoRail.astro';

const { capacitaciones } = home;
const fotos = capacitaciones?.fotos?.filter((f) => f.imagen) ?? [];
---

{fotos.length > 0 && (
  <section class="training section" id="capacitaciones">
    <div class="container">
      <SectionHeader
        eyebrow={capacitaciones.eyebrow}
        title={capacitaciones.titulo}
        subtitle={capacitaciones.subtitulo}
        align="center"
        class="reveal"
      />

      <PhotoRail
        fotos={fotos}
        ratio="3 / 4"
        perView={5}
        label="Capacitaciones en planta"
        ancho={900}
        alto={1200}
      />
    </div>
  </section>
)}

---
// Hero.astro — portada tipo banner: las fotos del rubro van cambiando solas
// detrás del título. Las fotos se editan desde el panel («Fotos de la portada»).
import { SITE, waLink } from '../../data/site.ts';
import home from '../../data/home.json';
const { hero } = home;
const fotos = hero?.fotos?.filter((f) => f.imagen) ?? [];
---

<section class="hero" id="inicio">
  <div class="container">
    <div class="banner" data-hero-banner>
      <div class="media">
        <div class="slides" aria-hidden="true">
          {fotos.map((foto, i) => (
            <img
              class:list={['slide', i === 0 && 'is-on']}
              src={foto.imagen}
              alt=""
              width="1600"
              height="800"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
            />
          ))}
          <span class="scrim"></span>
        </div>

        {fotos.length > 1 && (
          <div class="dots">
            {fotos.map((foto, i) => (
              <button
                type="button"
                class:list={['dot', i === 0 && 'is-on']}
                data-dot
                aria-label={foto.texto || `Foto ${i + 1}`}
                aria-current={i === 0 ? 'true' : 'false'}
              ></button>
            ))}
          </div>
        )}
      </div>

      <div class="banner-text">
        <p class="eyebrow">{SITE.tagline} · {SITE.city}</p>
        <h1>{hero.tituloLinea1}<br /><span class="hl">{hero.tituloDestacado}</span></h1>
        <p class="lead">{SITE.description}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={waLink('Hola J&M, quiero información sobre sus servicios.')}>
            {hero.botonWhatsapp}
          </a>
          <a class="btn btn-ghost" href="#servicios">{hero.botonServicios}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Poco aire arriba: el banner debe quedar cerca de la cabecera. */
  .hero { padding-block: var(--space-3) var(--space-6); }

  /* El banner vive dentro del contenedor, con el mismo ancho que el resto
     de la página. La proporción 2:1 evita que las fotos se recorten de más
     en pantallas anchas. */
  .banner {
    /* Tono del velo que oscurece las fotos, en un solo sitio.
       --velo-solido es ese mismo tono ya mezclado, para las zonas sin foto. */
    --velo: 9, 28, 7;
    --velo-solido: #152811;
    position: relative;
    isolation: isolate;
    display: grid;
    /* stretch para que la celda de la foto ocupe todo el alto del banner;
       el texto se centra por su cuenta con align-self. */
    align-items: stretch;
    aspect-ratio: 2 / 1;
    min-height: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    /* El banner no lleva el verde de la marca: su color es el mismo velo
       oscuro que cubre la foto, en sólido. */
    background: var(--velo-solido);
  }

  /* Foto y texto comparten la misma celda: el texto va encima. */
  .media { grid-area: 1 / 1; position: relative; }
  .banner-text {
    grid-area: 1 / 1;
    position: relative;
    align-self: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  /* --- Fotos que se cruzan por transparencia --- */
  .slides { position: absolute; inset: 0; }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 900ms ease-in-out;
  }
  .slide.is-on { opacity: 1; }

  /* Velo oscuro: sin él el texto blanco no se lee sobre las fotos claras. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg,
        rgba(var(--velo), 0.86) 0%,
        rgba(var(--velo), 0.66) 46%,
        rgba(var(--velo), 0.18) 100%);
  }

  /* --- Texto --- */
  .banner-text > * { max-width: 42rem; }
  .eyebrow { color: var(--color-accent); }
  .banner h1 { color: #fff; margin-block: var(--space-2) var(--space-3); }
  .hl { color: var(--color-accent); }
  .lead {
    font-size: var(--fs-lg);
    max-width: 42ch;
    color: color-mix(in srgb, #fff 88%, transparent);
  }

  .hero-cta { display: flex; gap: var(--space-2); margin-top: var(--space-4); flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-weight: var(--fw-semibold); padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full); border: 1.5px solid transparent;
    transition: transform var(--transition), background var(--transition), color var(--transition);
  }
  .btn-primary { background: var(--color-accent); color: var(--color-accent-ink); box-shadow: var(--shadow-sm); }
  .btn-primary:hover { background: var(--color-accent-deep); color: #fff; transform: translateY(-2px); }
  .btn-ghost { border-color: color-mix(in srgb, #fff 55%, transparent); color: #fff; }
  .btn-ghost:hover { background: color-mix(in srgb, #fff 14%, transparent); transform: translateY(-2px); }

  /* --- Puntitos: en qué foto vamos --- */
  .dots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: var(--space-2);
    display: flex;
    gap: 0.5rem;
    z-index: 2;
  }
  .dot {
    width: 34px;
    height: 4px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, #fff 40%, transparent);
    cursor: pointer;
    transition: background var(--transition);
  }
  .dot:hover { background: color-mix(in srgb, #fff 70%, transparent); }
  .dot.is-on { background: var(--color-accent); }
  .dot:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* En celular el texto no cabe encima sin recortar la foto a un cuadro
     vertical (queda con muchísimo zoom): la foto va arriba, en su tarjeta
     redondeada, y el texto debajo como contenido normal de la página, sobre
     el crema y en tinta oscura. */
  @media (max-width: 920px) {
    .banner {
      aspect-ratio: auto;
      min-height: 0;
      /* la tarjeta pasa a ser solo la foto */
      background: transparent;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
    }
    /* Alto explícito, no 'aspect-ratio': la celda de la foto solo contiene
       elementos posicionados (no aportan alto), y varios navegadores de
       celular la dejaban en cero, con lo que la foto no se veía.
       'align-self: start' evita además que el estirado del grid mande. */
    .media {
      grid-area: 1 / 1;
      align-self: start;
      height: 68vw;
      min-height: 220px;
      max-height: 400px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
    }
    .banner-text {
      grid-area: 2 / 1;
      align-self: stretch;
      background: transparent;
      padding: var(--space-3) 0 0;
    }
    /* Sin velo detrás, el texto va en los colores normales de la página. */
    .banner h1 { color: var(--color-ink); }
    .lead { max-width: none; color: var(--color-muted); }
    /* El ámbar del logo sobre el crema da 1.4:1 (invisible). Estos dos son el
       mismo ámbar rebajado hasta que se lee: el antetítulo es letra pequeña y
       necesita 4.5:1; el titular es grande y le basta 3:1. */
    .eyebrow { color: #8A5200; }
    .hl { color: #B87200; }
    .btn-ghost { border-color: var(--color-line); color: var(--color-primary); }
    .btn-ghost:hover { background: var(--color-primary-soft); }
    .scrim { background: linear-gradient(180deg, rgba(var(--velo), 0.28) 0%, rgba(var(--velo), 0.10) 100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
    .btn:hover { transform: none; }
  }
</style>

<script>
  // Banner de la portada: las fotos se cruzan solas cada 5 segundos.
  // - Se detiene mientras la pestaña está oculta o el banner no está a la vista.
  // - Los puntitos saltan a una foto concreta y pausan el avance un rato.
  // - Si el visitante pidió menos movimiento, no avanza solo: solo con los puntitos.
  document.querySelectorAll('[data-hero-banner]').forEach((banner) => {
    const slides = Array.from(banner.querySelectorAll('.slide'));
    const dots = Array.from(banner.querySelectorAll('[data-dot]'));
    if (slides.length < 2) return;

    const INTERVALO = 5000;  // ms que dura cada foto
    const REANUDAR = 10000;  // ms de pausa tras tocar un puntito
    const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    let actual = 0;
    let pausadoHasta = 0;
    let enPantalla = true;
    let temporizador = 0;

    const mostrar = (i) => {
      actual = (i + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle('is-on', n === actual));
      dots.forEach((d, n) => {
        d.classList.toggle('is-on', n === actual);
        d.setAttribute('aria-current', n === actual ? 'true' : 'false');
      });
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        pausadoHasta = Date.now() + REANUDAR;
        mostrar(i);
      });
    });

    const tick = () => {
      if (document.hidden || !enPantalla) return;
      if (Date.now() < pausadoHasta) return;
      mostrar(actual + 1);
    };

    const arrancar = () => {
      clearInterval(temporizador);
      if (!menosMovimiento.matches) temporizador = setInterval(tick, INTERVALO);
    };
    menosMovimiento.addEventListener('change', arrancar);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { enPantalla = e.isIntersecting; }, { threshold: 0 })
        .observe(banner);
    }

    arrancar();
  });
</script>

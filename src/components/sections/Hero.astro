---
// Hero.astro — portada.
//
// La foto NO sangra hasta el borde de la ventana: termina donde termina el
// contenedor, alineada con el botón de la cabecera. El cliente lo marcó
// expresamente (2026-09-01) y es el mismo criterio del panel de «Hablemos».
// Por eso la foto es una columna más de la rejilla y no un elemento
// posicionado: así el borde derecho coincide solo, sin cálculos.
//
// La forma del marco (desvanecido, curva y hoja) vive en ui/PhotoFrame.astro,
// que comparte con la llamada a la acción intermedia.
import { SITE, waLink } from '../../data/site.ts';
import home from '../../data/home.json';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PhotoFrame from '../ui/PhotoFrame.astro';

const { hero } = home;
const fotos = hero?.fotos?.filter((f) => f.imagen) ?? [];

// Micro-pruebas bajo los botones. Salen de home.json (editables desde el
// panel); si no estuvieran, no se dibuja la fila.
const ICONOS = ['shield-check', 'handshake', 'map-pin'];
const puntos = (hero?.puntos ?? []).filter((p) => p?.texto);
---

<section class="hero" id="inicio">
  <div class="container hero-inner">
    <!-- ── Mensaje ── -->
    <div class="hero-text">
      <p class="eyebrow reveal">{SITE.tagline} · {SITE.city}</p>

      <h1 class="reveal" data-delay="1">
        {hero.tituloLinea1}<br /><span class="hl">{hero.tituloDestacado}</span>
      </h1>

      <p class="lead reveal" data-delay="2">{SITE.description}</p>

      <div class="hero-cta reveal" data-delay="3">
        <Button
          href={waLink('Hola J&M, quiero información sobre sus servicios.')}
          variant="primary"
          size="lg"
          iconLeft="whatsapp"
          external
        >
          {hero.botonWhatsapp}
        </Button>
        <Button href="#servicios" variant="outline" size="lg" icon="arrow-right">
          {hero.botonServicios}
        </Button>
      </div>
    </div>

    <!-- ── Fotografía ── -->
    {fotos.length > 0 && <PhotoFrame fotos={fotos} leaf priority class="hero-media" />}

    {puntos.length > 0 && (
      <ul class="proofs reveal" data-delay="4">
        {puntos.map((punto, i) => (
          <li>
            <Icon name={ICONOS[i % ICONOS.length]} size={19} />
            <span>{punto.texto}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--section-y);
  }

  /* Lavado verde apenas perceptible en la esquina superior izquierda, como
     en la referencia. Igual que las franjas grises de base.css, se pinta
     dentro del ancho del contenedor y no hasta el borde de la ventana: en
     pantallas anchas el verde se derramaba por el margen izquierdo. */
  .hero::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(var(--container), 100%);
    border-radius: var(--radius-xl);
    background: radial-gradient(70% 55% at 0% 0%, rgba(54, 183, 41, 0.06), transparent 70%);
    z-index: -1;
  }

  /* Mismo motivo que en base.css: si el panel ya llega al borde de la
     pantalla, redondearlo deja muescas. */
  @media (max-width: 1180px) {
    .hero::before { border-radius: 0; }
  }

  .hero-inner {
    display: grid;
    /* Los dos botones de la portada suman 519 px. La columna de texto no puede
       bajar de ahí o caen en dos filas, así que las columnas van casi a
       partes iguales y el hueco entre ellas es el justo. */
    grid-template-columns: minmax(0, 0.99fr) minmax(0, 1.01fr);
    column-gap: clamp(1.25rem, 2.2vw, 2rem);
    align-items: start;
  }

  /* ---------- Mensaje ---------- */
  .hero-text { grid-column: 1; grid-row: 1; max-width: 34rem; }
  .hero-text h1 { margin-block: var(--space-2) 0; }
  /* El verde de --color-primary sobre blanco da 5.6:1: se lee sin problema
     y es el mismo tono del emblema, solo más profundo. */
  .hl { color: var(--color-primary); }

  .lead {
    margin-top: var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.65;
    max-width: 32rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  /* Tres micro-pruebas, bajo el mensaje y en su misma columna. */
  .proofs {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) clamp(1.25rem, 2.5vw, 2.25rem);
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--color-line);
  }
  .proofs li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-ink-soft);
  }
  .proofs :global(svg) { color: var(--color-primary); flex: none; }

  /* La foto ocupa la segunda columna y las dos filas del texto. Su borde
     derecho cae justo donde acaba el contenedor. */
  .hero-inner :global(.hero-media) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
  }

  /* Franja estrecha de escritorio (961–1120 px): la columna de texto se queda
     en ~460 px y los dos botones a tamaño grande suman 519, así que caían en
     dos filas. Un punto más compactos y vuelven a entrar en una. */
  @media (min-width: 961px) and (max-width: 1120px) {
    .hero-cta :global(.btn) {
      min-height: 48px;
      padding-inline: 1.15rem;
      font-size: var(--fs-sm);
    }
  }

  /* ---------- TABLET Y CELULAR ----------
     Una sola columna, en el orden que pide la lectura:
     mensaje → botones → foto → pruebas. */
  @media (max-width: 960px) {
    .hero::before { display: none; }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-text { grid-column: 1; grid-row: 1; max-width: 40rem; }
    .hero-inner :global(.hero-media) {
      grid-column: 1;
      grid-row: 2;
      margin-top: var(--space-4);
    }
    .proofs { grid-column: 1; grid-row: 3; }
  }

  /* En celular las micro-pruebas se apilan: en una fila quedarían apretadas
     y con saltos de línea feos. */
  @media (max-width: 560px) {
    .proofs { flex-direction: column; gap: 0.7rem; }
    .hero-cta :global(.btn) { width: 100%; }
  }
</style>

---
// TrustStrip.astro — propuesta de valor, justo debajo de la portada.
//
// El contenido son los MISMOS diferenciadores que ya existían en "Nosotros"
// (home.json → nosotros.diferenciadores). No se ha añadido ni quitado nada:
// solo suben a la primera pantalla, que es donde deciden si seguir leyendo.
import home from '../../data/home.json';
import Icon from '../ui/Icon.astro';

const diferenciadores = home.nosotros?.diferenciadores ?? [];

// Un icono por posición. Si el cliente añade más filas desde el panel, los
// iconos se repiten en lugar de romperse.
const ICONOS = ['handshake', 'sliders', 'shield-check', 'building'];
---

{diferenciadores.length > 0 && (
  <section class="trust band" aria-labelledby="trust-title">
    <div class="container">
      {/* Título solo para lectores de pantalla: la franja no lo necesita a la
          vista, pero sin él se saltaría del h1 de la portada a los h3 de cada
          bloque, y la jerarquía dejaría de ser navegable. */}
      <h2 id="trust-title" class="sr-only">Por qué trabajar con J&amp;M Consulting Foods</h2>

      <ul class="trust-grid">
        {diferenciadores.map((item, i) => (
          <li class="trust-item reveal" data-delay={String(Math.min(i, 5))}>
            <span class="trust-ic">
              <Icon name={ICONOS[i % ICONOS.length]} size={22} />
            </span>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .trust { padding-block: clamp(2.25rem, 4vw, 3.5rem); }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  /* Sin cajas ni bordes alrededor: solo un filete vertical que separa
     columnas. Menos ruido, más aire. */
  .trust-item { position: relative; padding-left: clamp(1.25rem, 2.4vw, 2rem); }
  .trust-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--color-line-2);
  }

  .trust-ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
    color: var(--color-primary-deep);
  }

  .trust-item h3 {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    margin-bottom: 0.35rem;
  }
  .trust-item p {
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); }
  }
  @media (max-width: 560px) {
    .trust-grid { grid-template-columns: 1fr; gap: var(--space-3); }
    /* En una sola columna el filete vertical no separa nada: se cambia por
       una línea horizontal entre elementos. */
    .trust-item { padding-left: 0; padding-top: var(--space-3); }
    .trust-item::before {
      left: 0; right: 0; top: 0; bottom: auto;
      width: auto; height: 1px;
    }
    .trust-item:first-child { padding-top: 0; }
    .trust-item:first-child::before { display: none; }
    /* El icono se pone al lado del título para ganar altura de pantalla. */
    .trust-ic { width: 38px; height: 38px; margin-bottom: 0.7rem; }
  }
</style>

---
// Ferias.astro — fotos en ferias y ruedas de negocio.
//
// Misma presentación que Capacitaciones: comparten el componente PhotoRail.
// Aquí son cinco fotos, así que en escritorio caben todas y las flechas se
// esconden solas; en pantallas menores aparecen para poder avanzar.
//
// Las fotos son 760×950 (4:5 exacto) y el marco respeta esa proporción:
// forzarlas a horizontal les corta cabezas y pies.
import home from '../../data/home.json';
import SectionHeader from '../ui/SectionHeader.astro';
import PhotoRail from '../ui/PhotoRail.astro';

const { ferias } = home;
const fotos = ferias?.fotos?.filter((f) => f.imagen) ?? [];
---

{fotos.length > 0 && (
  <section class="fairs section band" id="ferias">
    <div class="container">
      <SectionHeader
        eyebrow={ferias.eyebrow}
        title={ferias.titulo}
        subtitle={ferias.subtitulo}
        align="center"
        class="reveal"
      />

      <PhotoRail
        fotos={fotos}
        ratio="4 / 5"
        perView={5}
        label="Ferias y ruedas de negocio"
        ancho={760}
        alto={950}
      />
    </div>
  </section>
)}

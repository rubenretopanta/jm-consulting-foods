---
// Ferias.astro — carrusel de fotos en ferias y ruedas de negocio.
// La sección solo se renderiza si hay al menos una foto cargada.
import home from '../../data/home.json';
const { ferias } = home;
const fotos = ferias?.fotos?.filter((f) => f.imagen) ?? [];
---

{fotos.length > 0 && (
  <section class="fairs section" id="ferias">
    <div class="container">
      <header class="sec-head">
        <p class="eyebrow">{ferias.eyebrow}</p>
        <h2>{ferias.titulo}</h2>
        <p class="sec-sub">{ferias.subtitulo}</p>
      </header>

      <div class="carousel" data-ferias-carousel>
        <div
          class="track"
          data-track
          tabindex="0"
          role="region"
          aria-roledescription="carrusel"
          aria-label="Fotos en ferias y eventos"
        >
          {fotos.map((foto) => (
            <figure class="shot">
              <img
                src={foto.imagen}
                alt={foto.texto || ferias.titulo}
                width="760"
                height="507"
                loading="lazy"
                decoding="async"
              />
              {foto.texto && <figcaption>{foto.texto}</figcaption>}
            </figure>
          ))}
        </div>

        <div class="controls" data-controls hidden>
          <button type="button" class="nav" data-prev aria-label="Ver fotos anteriores">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 5 8 12l7 7" />
            </svg>
          </button>
          <button type="button" class="nav" data-next aria-label="Ver más fotos">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .fairs { background: var(--color-bg); }
  .sec-head { max-width: 620px; margin-bottom: var(--space-5); text-align: center; margin-inline: auto; }
  .sec-head h2 { margin-block: var(--space-1) var(--space-2); }
  .sec-sub { font-size: var(--fs-lg); }

  /* Una sola fila que se desliza. En celular se ve una foto grande y horizontal,
     con un asomo de la siguiente para que se note que hay más. */
  .carousel { --gap: var(--space-3); --per-view: 3; }

  .track {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* aire para que el hover y la sombra no se recorten */
    padding: 6px 2px 14px;
    margin-inline: -2px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; border-radius: var(--radius); }

  .shot {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .shot:hover { transform: translateY(-5px); box-shadow: var(--shadow); border-color: var(--color-primary); }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .shot figcaption {
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  /* Flechas: mismo trato que en el carrusel de clientes */
  .controls {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .controls[hidden] { display: none; }
  .nav {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-primary-deep);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition), color var(--transition), opacity var(--transition);
  }
  .nav svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav:hover:not(:disabled) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .nav:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .nav:disabled { opacity: 0.35; cursor: default; }

  @media (max-width: 920px) { .carousel { --per-view: 2; --gap: var(--space-2); } }
  /* En celular, una foto completa por vista: nada de asomos de la siguiente. */
  @media (max-width: 620px) {
    .carousel { --per-view: 1; }
    .nav { width: 42px; height: 42px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot:hover { transform: none; }
  }
</style>

<script>
  // Carrusel de ferias.
  // - Pasa solo cada 3 segundos, una foto por vez, y vuelve al inicio al terminar.
  // - Se detiene mientras el visitante mira (mouse encima, foco de teclado o dedo)
  //   y se reanuda un rato después.
  // - Las flechas avanzan una "página" (las fotos que se ven).
  // - Si todas las fotos caben en pantalla, no hay flechas ni movimiento.
  document.querySelectorAll('[data-ferias-carousel]').forEach((carousel) => {
    const track = carousel.querySelector('[data-track]');
    const controls = carousel.querySelector('[data-controls]');
    const prev = carousel.querySelector('[data-prev]');
    const next = carousel.querySelector('[data-next]');
    if (!track || !controls || !prev || !next) return;

    const INTERVALO = 3000;   // ms entre foto y foto
    const REANUDAR = 6000;    // ms de pausa tras tocar o usar las flechas
    const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    let temporizador = 0;
    let pausadoHasta = 0;
    let encima = false;
    let conFoco = false;

    // Ancho de una foto (incluido el hueco que la separa de la siguiente).
    const anchoFoto = () => {
      const foto = track.querySelector('.shot');
      if (!foto) return track.clientWidth;
      const hueco = parseFloat(getComputedStyle(track).columnGap) || 0;
      return foto.getBoundingClientRect().width + hueco;
    };

    const tope = () => track.scrollWidth - track.clientWidth;
    const alFinal = () => track.scrollLeft >= tope() - 2;

    const mover = (px) => track.scrollBy({ left: px, behavior: 'smooth' });

    // Flechas: una página entera de fotos.
    const pagina = (dir) => {
      const ancho = anchoFoto();
      const porVista = Math.max(1, Math.round(track.clientWidth / ancho));
      mover(dir * ancho * porVista);
    };

    const sync = () => {
      const max = tope();
      controls.hidden = max <= 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = alFinal();
    };

    const avanzarSolo = () => {
      if (encima || conFoco || document.hidden) return;
      if (Date.now() < pausadoHasta) return;
      if (tope() <= 1) return;
      if (alFinal()) track.scrollTo({ left: 0, behavior: 'smooth' });
      else mover(anchoFoto());
    };

    const pausar = () => { pausadoHasta = Date.now() + REANUDAR; };

    prev.addEventListener('click', () => { pausar(); pagina(-1); });
    next.addEventListener('click', () => { pausar(); pagina(1); });
    track.addEventListener('scroll', sync, { passive: true });
    track.addEventListener('pointerdown', pausar);
    track.addEventListener('touchstart', pausar, { passive: true });
    carousel.addEventListener('mouseenter', () => { encima = true; });
    carousel.addEventListener('mouseleave', () => { encima = false; });
    carousel.addEventListener('focusin', () => { conFoco = true; });
    carousel.addEventListener('focusout', () => { conFoco = false; });
    window.addEventListener('resize', sync);

    const arrancar = () => {
      clearInterval(temporizador);
      // Quien pidió menos movimiento avanza solo con las flechas.
      if (!menosMovimiento.matches) temporizador = setInterval(avanzarSolo, INTERVALO);
    };
    menosMovimiento.addEventListener('change', arrancar);

    sync();
    arrancar();
  });
</script>

---
// Services.astro — los servicios, tal como están en la colección de contenido.
// No se inventa ni se elimina ninguno: solo cambia cómo se presentan.
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import SectionHeader from '../ui/SectionHeader.astro';
import ServiceCard from '../ui/ServiceCard.astro';

const { serviciosSeccion } = home;

const services = (await getCollection('services')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Icono por servicio. La clave es el nombre del archivo .md; si el cliente
// crea uno nuevo desde el panel, cae en el icono genérico de documento.
const ICONO_POR_SERVICIO: Record<string, string> = {
  'registro-sanitario': 'file-check',
  'haccp': 'clipboard-check',
  'buenas-prácticas-bpm': 'leaf',
  'saneamiento': 'droplet',
  'iso': 'award',
  'capacitaciones': 'graduation',
};

const iconoDe = (id: string) => ICONO_POR_SERVICIO[id.replace(/\.md$/, '')] ?? 'file-check';
---

<section class="services section band" id="servicios">
  <div class="container">
    <SectionHeader
      eyebrow={serviciosSeccion.eyebrow}
      title={serviciosSeccion.titulo}
      subtitle={serviciosSeccion.subtitulo}
      align="center"
      class="reveal"
    />

    <div class="cards">
      {services.map((service, i) => (
        <ServiceCard
          title={service.data.title}
          description={service.data.description}
          image={service.data.image}
          icon={iconoDe(service.id)}
          bullets={service.data.bullets ?? []}
          delay={i % 3}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.2vw, 1.75rem);
    /* Las tarjetas crecen distinto según el texto: alinearlas arriba evita
       que una tarjeta corta se estire de forma rara. */
    align-items: stretch;
  }

  @media (max-width: 960px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } }
</style>

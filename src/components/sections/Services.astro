---
// Services.astro — lee los servicios desde la content collection
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
const { serviciosSeccion } = home;

const services = (await getCollection('services')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<section class="services section" id="servicios">
  <div class="container">
    <header class="sec-head">
      <p class="eyebrow">{serviciosSeccion.eyebrow}</p>
      <h2>{serviciosSeccion.titulo}</h2>
      <p class="sec-sub">{serviciosSeccion.subtitulo}</p>
    </header>

    <div class="cards">
      {services.map((service) => (
        <article class="card">
          <h3>{service.data.title}</h3>
          <p>{service.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { background: var(--color-bg); }
  .sec-head { max-width: 620px; margin-bottom: var(--space-5); }
  .sec-head h2 { margin-block: var(--space-1) var(--space-2); }
  .sec-sub { font-size: var(--fs-lg); }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-3);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: var(--color-primary);
  }
  .card h3 { font-size: var(--fs-xl); margin-bottom: var(--space-1); color: var(--color-primary-deep); }
  .card p { font-size: var(--fs-sm); }

  @media (max-width: 920px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
</style>
---
import home from '../../data/home.json';
const { proceso } = home;
const pasos = proceso.pasos;
---

<section class="process section" id="proceso">
  <div class="container">
    <header class="sec-head">
      <p class="eyebrow">{proceso.eyebrow}</p>
      <h2>{proceso.titulo}</h2>
      <p class="sec-sub">{proceso.subtitulo}</p>
    </header>

    <div class="steps">
      {pasos.map((paso) => (
        <article class="step">
          <span class="num">{paso.num}</span>
          <h3>{paso.titulo}</h3>
          <p>{paso.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sec-head { max-width: 620px; margin-bottom: var(--space-4); text-align: center; margin-inline: auto; }
  .sec-head h2 { margin-block: var(--space-1) var(--space-2); }
  .sec-sub { font-size: var(--fs-lg); }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .step { position: relative; padding-top: var(--space-2); }
  .num {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-3xl);
    color: var(--color-primary);
    opacity: 0.4;
    line-height: 1;
  }
  .step h3 { font-size: var(--fs-lg); margin-block: var(--space-1) 0.4rem; color: var(--color-primary-deep); }
  .step p { font-size: var(--fs-sm); }

  /* línea punteada entre pasos */
  .step::before {
    content: '';
    position: absolute;
    top: 26px;
    left: 70px;
    right: -12px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--color-line) 0 8px, transparent 8px 14px);
  }
  .step:last-child::before { display: none; }

  @media (max-width: 920px) {
    .steps { grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
    .step::before { display: none; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
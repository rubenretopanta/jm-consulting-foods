---
import home from '../../data/home.json';
const { nosotros } = home;
const diferenciadores = nosotros.diferenciadores;
---

<section class="about section" id="nosotros">
  <div class="container">
    <!-- Fila 1: foto del equipo + quiénes somos y misión -->
    <div class="intro-grid">
      {nosotros.foto && (
        <figure class="team-photo">
          <img src={nosotros.foto} alt="Equipo de J&M Consulting Foods" loading="lazy" decoding="async" />
        </figure>
      )}

      <div class="intro-text">
        <p class="eyebrow">{nosotros.eyebrow}</p>
        <h2>{nosotros.titulo}</h2>
        <p class="intro-lead">{nosotros.quienesSomos}</p>
        {nosotros.mision && (
          <div class="mision">
            <p class="mision-label">{nosotros.misionTitulo}</p>
            <p>{nosotros.mision}</p>
          </div>
        )}
      </div>
    </div>

    <!-- Fila 2: tarjeta de la consultora + diferenciadores -->
    <div class="about-grid">
      <div class="about-card">
        {nosotros.consultoraFoto ? (
          <img
            class="avatar avatar-foto"
            src={nosotros.consultoraFoto}
            alt={nosotros.consultoraNombre}
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="avatar">{nosotros.consultoraIniciales}</div>
        )}
        <h3>{nosotros.consultoraNombre} <span class="mag">{nosotros.consultoraGrado}</span></h3>
        <p class="role">{nosotros.consultoraRol}</p>
        <p class="bio">
          {nosotros.consultoraBio}
        </p>
      </div>

      <div class="about-text">
        <ul class="features">
          {diferenciadores.map((d) => (
            <li>
              <span class="tick">✓</span>
              <div>
                <strong>{d.titulo}</strong>
                <span>{d.texto}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: center;
    margin-bottom: var(--space-6);
  }
  .team-photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .team-photo img { display: block; width: 100%; height: auto; }

  .intro-text h2 { margin-block: var(--space-1) var(--space-3); }
  .intro-lead { font-size: var(--fs-lg); }
  .mision {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: var(--color-primary-soft);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }
  .mision-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: var(--fw-bold);
    color: var(--color-primary-deep);
    margin-bottom: 0.35rem;
  }
  .mision p:last-child { font-size: var(--fs-sm); color: var(--color-ink); }

  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .about-card {
    background: linear-gradient(150deg, var(--color-primary), var(--color-primary-deep));
    color: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow);
  }
  .avatar {
    width: 78px; height: 78px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-xl);
    margin-bottom: var(--space-2);
  }
  /* Cuando hay foto de la consultora, ocupa el mismo círculo que las iniciales. */
  .avatar-foto {
    display: block;
    object-fit: cover;
    border: 3px solid var(--color-accent);
  }
  .about-card h3 { color: #fff; font-size: var(--fs-xl); }
  .mag { font-size: var(--fs-base); font-weight: var(--fw-regular); opacity: 0.7; }
  .role { color: var(--color-accent); font-weight: var(--fw-semibold); font-size: var(--fs-sm); margin-block: 0.2rem var(--space-2); }
  .bio { color: rgba(255,255,255,0.85); font-size: var(--fs-sm); }

  .features { display: grid; gap: var(--space-3); }
  .features li { display: flex; gap: var(--space-2); align-items: flex-start; }
  .tick {
    flex: none;
    width: 30px; height: 30px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
    color: var(--color-primary-deep);
    display: grid; place-items: center;
    font-weight: var(--fw-bold);
    margin-top: 2px;
  }
  .features strong { display: block; font-family: var(--font-display); font-size: var(--fs-lg); color: var(--color-ink); }
  .features span { color: var(--color-muted); font-size: var(--fs-sm); }

  @media (max-width: 920px) {
    .intro-grid { grid-template-columns: 1fr; gap: var(--space-4); margin-bottom: var(--space-5); }
    .about-grid { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>

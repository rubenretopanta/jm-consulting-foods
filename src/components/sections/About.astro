---
// About.astro — quiénes somos, la misión y la consultora que atiende.
//
// El contenido es el mismo de siempre. Los cuatro diferenciadores ya no se
// repiten aquí: subieron a la franja de confianza, justo debajo de la portada
// (TrustStrip.astro), que es donde el visitante todavía está decidiendo.
import home from '../../data/home.json';
import { SITE } from '../../data/site.ts';
import Icon from '../ui/Icon.astro';

const { nosotros } = home;
---

<section class="about section band" id="nosotros">
  <div class="container">
    <div class="about-grid">
      <!-- Columna izquierda: el relato -->
      <div class="about-text">
        <p class="eyebrow reveal">{nosotros.eyebrow}</p>
        <h2 class="reveal" data-delay="1">{nosotros.titulo}</h2>
        <p class="lead reveal" data-delay="1">{nosotros.quienesSomos}</p>

        {nosotros.mision && (
          <blockquote class="mision reveal" data-delay="2">
            <p class="mision-label">{nosotros.misionTitulo}</p>
            <p class="mision-text">{nosotros.mision}</p>
          </blockquote>
        )}

        <dl class="facts reveal" data-delay="3">
          <div class="fact">
            <dt><Icon name="id-card" size={17} /><span>Razón social</span></dt>
            <dd>{SITE.legalName}</dd>
          </div>
          <div class="fact">
            <dt><Icon name="badge-check" size={17} /><span>RUC</span></dt>
            <dd>{SITE.ruc}</dd>
          </div>
          <div class="fact">
            <dt><Icon name="map-pin" size={17} /><span>Base</span></dt>
            <dd>{SITE.address}</dd>
          </div>
        </dl>
      </div>

      <!-- Columna derecha: la foto del equipo y la ficha de la consultora -->
      <div class="about-side">
        {nosotros.foto && (
          <figure class="team-photo reveal" data-delay="1">
            <img
              src={nosotros.foto}
              alt="Equipo de J&M Consulting Foods"
              width="1400"
              height="933"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}

        <article class="consultora reveal" data-delay="2">
          {nosotros.consultoraFoto ? (
            <img
              class="avatar"
              src={nosotros.consultoraFoto}
              alt={nosotros.consultoraNombre}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="avatar avatar-iniciales">{nosotros.consultoraIniciales}</div>
          )}

          <div class="consultora-body">
            <p class="role">{nosotros.consultoraRol}</p>
            <h3>{nosotros.consultoraNombre} <span class="mag">{nosotros.consultoraGrado}</span></h3>
            <p class="bio">{nosotros.consultoraBio}</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: start;
  }

  /* ---------- Relato ---------- */
  .about-text h2 { margin-block: 0.6rem 0; max-width: 20ch; }
  .lead {
    margin-top: var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.65;
  }

  /* La misión, destacada como cita: rompe el bloque de texto y le da peso. */
  .mision {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-brand-green);
    background: var(--color-primary-tint);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .mision-label {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary-deep);
    margin-bottom: 0.4rem;
  }
  .mision-text { color: var(--color-ink-soft); font-size: var(--fs-md); line-height: 1.6; }

  /* Datos verificables de la empresa, en fila y sin cajas. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }
  .fact dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .fact dt :global(svg) { color: var(--color-primary); flex: none; }
  .fact dd {
    margin-top: 0.3rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  /* ---------- Foto y consultora ---------- */
  .about-side { display: grid; gap: var(--space-3); }

  .team-photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .team-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* Ficha de la consultora: panel verde con texto blanco, el mismo criterio
     de contraste que el resto de superficies verdes del sitio. */
  .consultora {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: linear-gradient(140deg, var(--color-primary-surface), var(--color-primary));
    color: #fff;
    box-shadow: var(--shadow);
  }
  .avatar {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.55);
  }
  .avatar-iniciales {
    display: grid;
    place-items: center;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    border-color: var(--color-accent);
  }
  .consultora-body { min-width: 0; }
  /* En blanco, no en ambar: el ambar sobre este verde da 3.5:1 y este texto
     es de 12 px. El acento de color lo pone el borde de la foto. */
  .role {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.94);
  }
  .consultora h3 { color: #fff; font-size: var(--fs-lg); margin-top: 0.2rem; }
  .mag { font-size: var(--fs-sm); font-weight: var(--fw-regular); opacity: 0.85; }
  .bio {
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .about-text h2 { max-width: none; }
  }
  @media (max-width: 560px) {
    /* En celular la ficha se apila: en fila, la foto deja al texto un ancho
       de dos palabras por línea. */
    .consultora { flex-direction: column; align-items: flex-start; text-align: left; }
    .avatar { width: 72px; height: 72px; }
  }
</style>

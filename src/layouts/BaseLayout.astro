---
// BaseLayout.astro — esqueleto común de todas las páginas
import Header from '../components/layout/Header.astro';
import { SITE } from '../data/site.ts';
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.name,
  description = SITE.description,
} = Astro.props;

// Título de pestaña: "Sección · J&M Consulting Foods"
const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="fwRjwQkCsZzx1ncoEpFxqpHtMrFhDaMFWMVsy6xElNc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph (para que se vea bien al compartir en WhatsApp/redes) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />

    <!-- Fuentes de la marca -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>
   <body>
    <Header />
    <slot />
     <Footer />
  </body>
</html>